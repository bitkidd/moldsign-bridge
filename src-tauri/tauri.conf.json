{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoldSign Bridge Alpha",
  "version": "0.1.0-alpha.1",
  "identifier": "dev.basicshapes.moldsign-bridge",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "MoldSign Bridge",
        "width": 480,
        "height": 680,
        "minWidth": 460,
        "minHeight": 640,
        "maxWidth": 560,
        "maxHeight": 800,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDNzMxMDJBQzk0QkY5RUEKUldUcStVdkpLaEJ6ZkNqYkxhUGpTSEpJN2lEdEZXQ215SElaazAzT3N5YUtyMGhVNk1hTTlDUHAK",
      "endpoints": [
        "https://github.com/bitkidd/moldsign-bridge/releases/download/alpha/latest.json"
      ]
    }
  }
}
